# ============================================================
# .env.example — Template de configuration
# Copier ce fichier en .env et remplir les valeurs réelles
# Ne JAMAIS commiter le fichier .env !
# ============================================================

# Clé secrète Flask (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=changeme_generate_with_python_secrets_token_hex_32

# URL de la base de données
DATABASE_URL=sqlite:////app/data/todos.db

# Environnement (development | production | testing)
FLASK_ENV=production
FLASK_DEBUG=0

# JWT (générer avec : python -c "import secrets; print(secrets.token_hex(64))")
JWT_SECRET=changeme_generate_with_python_secrets_token_hex_64
JWT_EXPIRATION_HOURS=1

# Rate limiting
RATELIMIT_STORAGE_URL=memory://
